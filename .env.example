# Токен бота от @BotFather — НЕОБЯЗАТЕЛЕН.
# Основная проверка идёт по публичным страницам t.me. Токен включает резервный канал
# (Bot API getChat) на случай, когда t.me недоступен или ограничил частоту.
BOT_TOKEN=

# Порт локального сайта (по умолчанию 3000)
PORT=3000

# Демо-режим без обращения к Telegram (1 = включён). Удобно, чтобы посмотреть интерфейс.
# В демо-режиме результаты ВЫДУМАННЫЕ.
TELEGRAM_MOCK=0

# Разрешить вводить токен прямо в интерфейсе (1 = да, 0 = только через .env)
ALLOW_CLIENT_TOKEN=1

# Скорость проверки: одновременных запросов и минимальная пауза между ними (мс)
CHECK_CONCURRENCY=2
CHECK_MIN_INTERVAL_MS=320

# С какого домена разрешено обращаться к API (нужно для хостинга фронтенда отдельно,
# например на GitHub Pages). "*" — откуда угодно, для продакшена лучше указать свой домен.
CORS_ORIGIN=*
